{
  "name": "calendar-gadget",
  "version": "2.5.0",
  "description": "Windows 11 desktop calendar gadget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis",
    "pack:portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.calendar.gadget",
    "productName": "Calendar Gadget",
    "directories": {
      "output": "dist-v25"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "db.js",
      "index.html",
      "styles.css",
      "package.json",
      "assets/**/*"
    ],
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calendar Gadget"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
