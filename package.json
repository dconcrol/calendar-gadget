{
  "name": "calendar-gadget",
  "version": "9.0.9",
  "description": "Windows 11 desktop calendar gadget",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis && node -e \"const fs=require('fs');const p=require('./package.json').build.directories.output;for(const n of fs.readdirSync(p)){if(!/^Calendar Gadget Setup .+\\.exe$/i.test(n))fs.rmSync(require('path').join(p,n),{recursive:true,force:true})}\"",
    "pack:portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.calendar.gadget",
    "productName": "Calendar Gadget",
    "directories": {
      "output": "dist-v909"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "db.js",
      "index.html",
      "styles.css",
      "package.json",
      "trayIcon.js",
      "assets/icon.png",
      "assets/icon-16.png",
      "assets/tray-icon.png"
    ],
    "afterPack": "./afterPack.js",
    "afterAllArtifactBuild": "./afterAllArtifactBuild.js",
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "asar": true,
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Calendar Gadget",
      "differentialPackage": false,
      "packElevateHelper": false
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
